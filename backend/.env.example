# =========================================================================
#  Kilo — allenamento e nutrizione — configurazione backend
#  Copia questo file in `.env` e compila i valori. NON committare `.env`.
# =========================================================================

# --- Sessioni (OBBLIGATORIA) ------------------------------------------
# Chiave con cui vengono firmati i token di accesso: almeno 32 caratteri.
# Senza, registrazione e accesso non funzionano. Generala con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Database (Neon PostgreSQL) ---------------------------------------
# Crea un progetto gratuito su https://neon.tech e copia la connection
# string "pooled". Deve terminare con ?sslmode=require (richiesto da Neon).
# Esempio:
# DATABASE_URL=postgresql+psycopg://utente:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@host.neon.tech/neondb?sslmode=require

# --- Google Gemini (piano GRATUITO) -----------------------------------
# Chiave gratuita (senza carta di credito) da https://aistudio.google.com/apikey
# Serve a personalizzare e spiegare schede e consigli — MAI a inventare i
# numeri, che arrivano dai file in app/knowledge_base/.
# È OPZIONALE: senza chiave i piani vengono comunque generati dai parametri
# della knowledge base, solo senza il testo esplicativo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- USDA FoodData Central (GRATUITO) ---------------------------------
# Chiave gratuita self-service (1000 richieste/ora, nessuna carta):
# https://fdc.nal.usda.gov/api-key-signup
# Copre gli alimenti generici/grezzi (petto di pollo, uova, verdure), dove il
# database di wger/Open Food Facts è più debole perché orientato ai prodotti
# confezionati. Senza chiave l'app usa solo wger.
USDA_API_KEY=

# --- Integrazioni senza chiave ----------------------------------------
# wger (esercizi + ingredienti) e TheMealDB (ricette) espongono endpoint
# pubblici: non serve registrarsi. Cambia questi valori solo se vuoi puntare
# a un'istanza self-hosted di wger.
WGER_BASE_URL=https://wger.de/api/v2
THEMEALDB_BASE_URL=https://www.themealdb.com/api/json/v1/1

# --- App --------------------------------------------------------------
# Origini consentite per il CORS del frontend (separate da virgola).
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
